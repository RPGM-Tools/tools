{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rpgm.tools/schemas/lore_crystal.schema.json",
  "$comment": "File: lorecrystal.schema.json | Purpose: Draft Lore Crystal schema for RPGM | Updated: 2025-10-06",
  "title": "RPGM Lore Crystal",
  "description": "Canonical schema for Lore Crystals across the RPGM ecosystem.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "type": {
      "type": "string",
      "pattern": "^lore_crystal/[a-z0-9_\\-]+$"
    },
    "seed_id": {
      "$ref": "#/$defs/uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/linkEdge"
      },
      "uniqueItems": true
    },
    "storage": {
      "$ref": "#/$defs/storageDescriptor"
    },
    "content_uri": {
      "type": "string",
      "format": "uri"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-z0-9]+:[a-f0-9]{64}$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9.+-]+$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "embedding_model": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "creator_id": {
      "type": "string",
      "minLength": 1
    },
    "sharing_scope": {
      "type": "string",
      "enum": ["private", "campaign", "public"]
    },
    "sensitivity": {
      "type": "string",
      "enum": ["general", "safety_review", "restricted"]
    },
    "tamper_hash": {
      "type": "string",
      "pattern": "^[a-z0-9]+:[a-f0-9]{64}$"
    },
    "state": {
      "type": "string",
      "enum": ["rough", "refined"]
    },
    "usage": {
      "$ref": "#/$defs/usageDescriptor"
    },
    "doc_id": {
      "$ref": "#/$defs/uuid"
    },
    "section_path": {
      "type": "string",
      "minLength": 1
    },
    "ordinal": {
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/provenanceDescriptor"
    },
    "history": {
      "$ref": "#/$defs/historyDescriptor"
    },
    "vault": {
      "$ref": "#/$defs/vaultNamespace"
    },
    "tome": {
      "$ref": "#/$defs/tomeNamespace"
    },
    "atlas": {
      "$ref": "#/$defs/atlasNamespace"
    },
    "scroll": {
      "$ref": "#/$defs/scrollNamespace"
    },
    "quill": {
      "$ref": "#/$defs/quillNamespace"
    },
    "herald": {
      "$ref": "#/$defs/heraldNamespace"
    },
    "worlds": {
      "$ref": "#/$defs/worldsNamespace"
    },
    "forge": {
      "$ref": "#/$defs/forgeNamespace"
    },
    "rules_engine": {
      "$ref": "#/$defs/rulesEngineNamespace"
    },
    "secret_engine": {
      "$ref": "#/$defs/secretEngineNamespace"
    },
    "custom": {
      "type": "object",
      "additionalProperties": true
    },
    "additional_data": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "name",
    "description",
    "creator_id",
    "created_at",
    "updated_at",
    "state",
    "provenance",
    "sharing_scope"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "refined"
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": [
          "storage",
          "content_hash",
          "media_type",
          "size_bytes",
          "usage"
        ],
        "properties": {
          "usage": {
            "required": ["storage"],
            "properties": {
              "storage": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "embedding": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["embedding"]
      },
      "then": {
        "required": ["embedding_model"],
        "properties": {
          "embedding_model": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "required": ["tome"],
        "properties": {
          "tome": {
            "type": "object",
            "properties": {
              "worlds": {
                "type": "object",
                "minProperties": 1
              }
            },
            "required": ["worlds"]
          }
        }
      },
      "then": {
        "required": ["usage"],
        "properties": {
          "usage": {
            "required": ["graph", "world_ids"],
            "properties": {
              "graph": {
                "const": true
              },
              "world_ids": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "linkEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "label"],
      "properties": {
        "to": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "certainty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "storageDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "content_id"],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "content_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "usageDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": {
          "type": "boolean"
        },
        "graph": {
          "type": "boolean"
        },
        "world_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "graph_count": {
          "type": "integer",
          "minimum": 0
        },
        "exports": {
          "type": "integer",
          "minimum": 0
        },
        "last_exported_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "provenanceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceDescriptor"
          },
          "minItems": 1
        },
        "generators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generatorDescriptor"
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformDescriptor"
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approvalDescriptor"
          }
        },
        "signatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signatureDescriptor"
          }
        },
        "custody": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/custodyDescriptor"
          }
        },
        "validations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationDescriptor"
          }
        },
        "notes": {
          "type": "string"
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["sources"]
    },
    "sourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "external_uri": {
          "type": "string",
          "format": "uri"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string"
        },
        "license_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "anyOf": [{ "required": ["id"] }, { "required": ["external_uri"] }]
    },
    "generatorDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "transformDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step"],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "diff_uri": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "approvalDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "timestamp"],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "signatureDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "jws"],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "jws": {
          "type": "string",
          "minLength": 1
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "verification_method": {
          "type": "string"
        }
      }
    },
    "custodyDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "timestamp"],
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "location": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "validationDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash"],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[a-z0-9]+:[a-f0-9]{64}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "tool": {
          "type": "string"
        }
      }
    },
    "historyDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historyEntry"
          }
        },
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historySnapshot"
          }
        }
      }
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "diff_uri", "checksum"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string"
        },
        "diff_uri": {
          "type": "string",
          "format": "uri"
        },
        "checksum": {
          "type": "string",
          "pattern": "^[a-z0-9]+:[a-f0-9]{64}$"
        },
        "format": {
          "type": "string",
          "enum": ["json_patch"]
        },
        "applied_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "historySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content_uri"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "content_uri": {
          "type": "string",
          "format": "uri"
        },
        "checksum": {
          "type": "string",
          "pattern": "^[a-z0-9]+:[a-f0-9]{64}$"
        }
      }
    },
    "vaultNamespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analytics": {
          "type": "object",
          "additionalProperties": true
        },
        "checksums": {
          "type": "object",
          "additionalProperties": true
        },
        "captions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "tomeNamespace": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "worlds": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/tomeWorldDescriptor"
          }
        },
        "default_profile": {
          "$ref": "#/$defs/tomeWorldDescriptor"
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "anyOf": [
        { "required": ["worlds"] },
        { "required": ["default_profile"] },
        { "required": ["additional_data"] }
      ]
    },
    "tomeWorldDescriptor": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "world_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "graph": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphEdge"
          }
        },
        "appearance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/appearanceDescriptor"
          }
        },
        "timeline": {
          "$ref": "#/$defs/timelineDescriptor"
        },
        "canon_state": {
          "type": "string",
          "enum": ["draft", "canon", "retconned"]
        },
        "factions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "session_notes": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "safety_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "knowledge": {
          "$ref": "#/$defs/tomeKnowledgeDescriptor"
        },
        "notes": {
          "type": "string"
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "tomeKnowledgeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "facets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeFacet"
          }
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "knowledgeFacet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "attribute",
            "relationship",
            "secret",
            "status",
            "inventory",
            "history",
            "custom"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "rumored",
            "partial",
            "confirmed",
            "obsolete",
            "redacted"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "holders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeHolder"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeSourceDescriptor"
          }
        },
        "notes": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "knowledgeHolder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder_id"],
      "properties": {
        "holder_id": {
          "type": "string",
          "minLength": 1
        },
        "holder_type": {
          "type": "string",
          "enum": ["pc", "npc", "faction", "party", "system"]
        },
        "awareness": {
          "type": "string",
          "enum": ["unknown", "suspects", "partial", "full", "forgotten"]
        },
        "first_known_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "knowledgeSourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crystal_id": {
          "$ref": "#/$defs/uuid"
        },
        "external_uri": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        }
      },
      "anyOf": [
        { "required": ["crystal_id"] },
        { "required": ["external_uri"] }
      ]
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rel", "target"],
      "properties": {
        "rel": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/uuid"
        },
        "certainty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "appearanceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "crystal_id"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "crystal_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "timelineDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "era": {
          "type": "string"
        },
        "campaign_day": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "atlasNamespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "map_layer": {
          "type": "string"
        },
        "coordinates": {
          "$ref": "#/$defs/coordinatesDescriptor"
        },
        "render_style": {
          "type": "string"
        },
        "tileset_id": {
          "type": "string"
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "coordinatesDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "scale": {
          "type": "number"
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "scrollNamespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheet_layout": {
          "type": "string"
        },
        "widgets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": true
        },
        "ruleset": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "quillNamespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_transcript": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pending_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "moderation_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additional_data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "heraldNamespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persona_id": {
